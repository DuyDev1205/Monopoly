; Cờ Tỷ Phú Việt Nam — bản app dựng bằng Godot 4
config_version=5

[application]

config/name="Cờ Tỷ Phú Việt Nam"
config/description="Cờ tỷ phú với địa danh Việt Nam"
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.99, 0.93, 0.95, 1)
boot_splash/show_image=false

[autoload]

Data="*res://scripts/data.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/BeVietnamPro-Bold.ttf"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.99, 0.93, 0.95, 1)
