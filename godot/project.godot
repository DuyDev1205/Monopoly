; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cờ Tỷ Phú Việt Nam"
config/description="Cờ tỷ phú với địa danh Việt Nam"
config/version="2.2.1"
run/main_scene="res://scenes/main2d.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.99, 0.93, 0.95, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Data="*res://scripts/data.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/BeVietnamPro-Bold.ttf"

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.99, 0.93, 0.95, 1)
anti_aliasing/quality/screen_space_aa=1
