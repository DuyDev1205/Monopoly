[Unit]
Description=Co Ty Phu Viet Nam - server choi online
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/_gitclone/monopoly/server
Environment=PORT=8387
Environment=HOST=127.0.0.1
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=128 server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
